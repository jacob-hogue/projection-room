{
  "name": "dial-pulse-film",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts DialPulse ../../../public/dial-pulse/film.mp4",
    "render:loop": "remotion render src/index.ts Loop ../../../public/dial-pulse/loop.mp4",
    "still": "remotion still src/index.ts DialPulse ../../../public/dial-pulse/film-still.png --frame=300",
    "prestudio": "node scripts/sync.mjs",
    "prerender": "node scripts/sync.mjs",
    "prestill": "node scripts/sync.mjs",
    "frames": "node scripts/frames.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "^4.0.541",
    "culori": "^4.0.2",
    "d3": "^7.9.2",
    "d3-transition": "^3.0.1",
    "polylabel": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.541",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/d3": "^7.4.3",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.9.0"
