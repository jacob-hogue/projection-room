---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Geospatial data stories by Jacob Hogue.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>jacob<span class="dot">.</span>hogue / <span class="lab">lab</span></a>
      <a class="home-link" href="https://jacob-hogue.github.io/">jacob-hogue.github.io</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      The Lab is part of <a href="https://jacob-hogue.github.io/">jacob-hogue.github.io</a>.
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --surface: #0f1117;
    --card: rgba(15, 17, 23, 0.8);
    --border: rgba(255, 255, 255, 0.06);
    --border-hover: rgba(255, 255, 255, 0.12);
    --text-1: #e8eaed;
    --text-2: #8b8fa3;
    --text-3: #4a4e5a;
    --accent: #38bdf8;
    --accent-dim: rgba(56, 189, 248, 0.1);
    --green: #34d399;
    --lab: #d9137f;
    --sans: 'DM Sans', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scrollbar-color: #2a2f3d var(--surface); }
  body {
    background: var(--surface);
    color: var(--text-2);
    font-family: var(--sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: rgba(56, 189, 248, 0.35); color: #fff; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  h1, h2, h3 { color: var(--text-1); letter-spacing: -0.02em; line-height: 1.15; }
  .mono { font-family: var(--mono); }

  .site-header {
    position: sticky; top: 0; z-index: 10;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 14px 24px;
    background: rgba(8, 9, 13, 0.85); backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .wordmark { font-weight: 700; font-size: 16px; color: var(--text-1); letter-spacing: 0.02em; white-space: nowrap; }
  .wordmark .dot { color: var(--accent); }
  .wordmark .lab { color: var(--lab); }
  .home-link { font-size: 13px; color: var(--text-2); }
  .home-link:hover { color: var(--text-1); }
  main { min-height: 70vh; }
  .site-footer {
    padding: 32px 24px; border-top: 1px solid var(--border);
    font-size: 13px; color: var(--text-3); text-align: center;
  }
  .site-footer a { color: var(--text-2); }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
