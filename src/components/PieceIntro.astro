---
/** Plain context before any data: the piece's own words, set as prose. */
interface Props {
  heading: string;
  paragraphs: string[];
}
const { heading, paragraphs } = Astro.props;
---
<section class="intro-prose" aria-labelledby="intro-heading">
  <h2 id="intro-heading">{heading}</h2>
  {paragraphs.map((p) => <p>{p}</p>)}
</section>

<style>
  .intro-prose { max-width: 1200px; margin: 0 auto; padding: 40px 24px 16px; }
  .intro-prose h2 { font-size: clamp(24px, 2.6vw, 34px); margin-bottom: 18px; }
  .intro-prose p { font-size: 18px; line-height: 1.7; max-width: 62ch; color: var(--text-2); margin-bottom: 16px; }
  .intro-prose p:first-of-type { color: var(--text-1); font-size: 20px; }
</style>
