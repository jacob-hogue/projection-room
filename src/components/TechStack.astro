---
/** The core tools behind a piece, as a scannable list. Every piece page carries one. */
interface Item {
  label: string;
  value: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<section class="stack" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="mono">Tech stack</h2>
  <dl>
    {items.map((i) => (
      <div class="stack-row">
        <dt>{i.label}</dt>
        <dd>{i.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .stack { max-width: 1200px; margin: 0 auto; padding: 24px 24px 8px; }
  .stack h2 { font-size: 12px; font-weight: 500; color: var(--accent); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px 24px; margin: 0; padding: 16px 20px; border: 1px solid var(--border); border-left: 2px solid var(--accent); border-radius: 12px; background: var(--card); }
  .stack-row { display: grid; grid-template-columns: 130px 1fr; gap: 12px; align-items: baseline; }
  dt { font-family: var(--mono); font-size: 12px; color: var(--text-2); letter-spacing: 0.02em; }
  dd { margin: 0; font-size: 15px; color: var(--text-1); font-weight: 500; }
  @media (max-width: 480px) { .stack-row { grid-template-columns: 1fr; gap: 2px; } }
</style>
