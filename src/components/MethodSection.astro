---
/** Method, data, known gaps and credits, with the pipeline diagram and the population chart. */
interface Step {
  name: string;
  detail: string;
}
interface Source {
  name: string;
  detail: string;
  href: string;
}
interface Props {
  intro: string[];
  steps: Step[];
  pulses: string;
  sources: Source[];
  gaps: string[];
  credit: string;
  repo: string;
}
const { intro, steps, pulses, sources, gaps, credit, repo } = Astro.props;
// Diagram geometry: one node per step on a single line, 1.5 px strokes, rounded nodes.
const NODE_W = 150;
const NODE_H = 48;
const GAP = 44;
const PAD = 8;
const W = PAD * 2 + steps.length * NODE_W + (steps.length - 1) * GAP;
const H = NODE_H + PAD * 2;
---
<section class="method" id="method" aria-labelledby="method-heading">
  <h2 id="method-heading">How the map was made</h2>
  {intro.map((p) => <p class="method-prose">{p}</p>)}

  <figure class="diagram-wrap">
    <svg class="diagram" viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={`Pipeline: ${steps.map((s) => s.name).join(', ')}`}>
      <defs>
        <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent)" />
        </marker>
      </defs>
      {steps.map((s, i) => {
        const x = PAD + i * (NODE_W + GAP);
        return (
          <g>
            {i < steps.length - 1 ? (
              <line class="flow" x1={x + NODE_W} y1={PAD + NODE_H / 2} x2={x + NODE_W + GAP - 2} y2={PAD + NODE_H / 2} marker-end="url(#flow-arrow)" />
            ) : null}
            <rect class="node" x={x} y={PAD} width={NODE_W} height={NODE_H} rx="10" />
            <text class="node-index" x={x + 14} y={PAD + 19}>{String(i + 1).padStart(2, '0')}</text>
            <text class="node-name" x={x + 14} y={PAD + 37}>{s.name}</text>
          </g>
        );
      })}
    </svg>
    <figcaption>
      <ol class="pipeline">
        {steps.map((s) => (
          <li><strong>{s.name}.</strong> {s.detail}.</li>
        ))}
      </ol>
    </figcaption>
  </figure>

  <h3>Clicks against people</h3>
  <p class="method-prose">{pulses}</p>
  <div class="scatter method-scatter" data-scatter aria-label="Clicks to dial each 1947 area code against the 1950 population of its territory"></div>

  <h3>Sources</h3>
  <ul class="sources">
    {sources.map((s) => (
      <li>
        <a href={s.href} rel="noopener">{s.name}</a>
        <span>{s.detail}</span>
      </li>
    ))}
  </ul>

  <h3>Known gaps</h3>
  <ul class="gaps">
    {gaps.map((g) => <li>{g}</li>)}
  </ul>

  <h3>Credit</h3>
  <p class="method-prose">{credit}</p>
  <p class="method-prose"><a href={repo} rel="noopener">Code and data on GitHub</a></p>
</section>

<style>
  .method { max-width: 1200px; margin: 0 auto; padding: 40px 24px 48px; }
  .method h2 { font-size: clamp(24px, 2.6vw, 34px); margin-bottom: 18px; }
  .method h3 { font-size: 20px; margin: 32px 0 12px; }
  .method-prose { font-size: 17px; line-height: 1.7; max-width: 72ch; color: var(--text-2); margin-bottom: 14px; }
  .method-prose a { color: var(--accent); }
  .diagram-wrap { margin: 24px 0 8px; }
  .diagram { display: block; max-width: 100%; height: auto; overflow: visible; }
  .diagram .node { fill: #151823; stroke: var(--border-hover); stroke-width: 1.5; }
  .diagram .node-index { font: 500 11px var(--mono); fill: var(--accent); letter-spacing: 0.08em; }
  .diagram .node-name { font: 600 15px var(--sans); fill: var(--text-1); }
  .diagram .flow { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 5 5; animation: flow 1.2s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -10; } }
  .pipeline { margin-top: 14px; padding-left: 20px; display: grid; gap: 6px; font-size: 15px; line-height: 1.6; color: var(--text-2); max-width: 80ch; }
  .pipeline strong { color: var(--text-1); font-weight: 600; }
  .method-scatter { max-width: 640px; }
  .method-scatter :global(svg) { display: block; width: 100%; height: auto; }
  .method-scatter :global(.axis text) { fill: var(--text-2); font: 500 11px var(--mono); }
  .method-scatter :global(.axis line) { stroke: rgba(255, 255, 255, 0.07); }
  .method-scatter :global(.axis .domain) { display: none; }
  .method-scatter :global(.axis-title) { fill: var(--text-2); font: 500 11px var(--mono); }
  .method-scatter :global(.dot-labels text) { fill: var(--text-1); font: 600 11px var(--sans); paint-order: stroke; stroke: var(--surface); stroke-width: 3px; stroke-linejoin: round; }
  .sources, .gaps { list-style: none; display: grid; gap: 10px; max-width: 80ch; }
  .sources li { display: grid; gap: 2px; font-size: 15px; line-height: 1.55; color: var(--text-2); }
  .sources a { color: var(--text-1); font-weight: 600; }
  .sources a:hover { color: var(--accent); }
  .gaps li { font-size: 15px; line-height: 1.6; color: var(--text-2); padding-left: 16px; position: relative; }
  .gaps li::before { content: ''; position: absolute; left: 0; top: 10px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .diagram .flow { animation: none; } }
</style>
