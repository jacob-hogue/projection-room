---
/** Title, one-line rule, the loop (or the poster), three mono facts. */
interface Props {
  title: string;
  rule: string;
  poster: string;
  posterAlt: string;
  loop?: string | null;
  facts: string[];
}
const { title, rule, poster, posterAlt, loop = null, facts } = Astro.props;
---
<section class="opening">
  <div class="opening-text">
    <h1>{title}</h1>
    <p class="rule">{rule}</p>
  </div>
  <figure class="opening-media">
    {loop ? (
      <video class="loop" muted autoplay loop playsinline poster={poster} aria-label={posterAlt}>
        <source src={loop} type="video/mp4" />
      </video>
    ) : null}
    <img class="poster" src={poster} alt={posterAlt} width="1400" height="880" decoding="async" fetchpriority="high" />
  </figure>
  <ul class="facts mono">
    {facts.map((f) => <li>{f}</li>)}
  </ul>
</section>

<style>
  .opening { max-width: 1200px; margin: 0 auto; padding: 56px 24px 24px; }
  .opening-text { max-width: 60ch; margin-bottom: 28px; }
  h1 { font-size: clamp(34px, 5vw, 60px); margin-bottom: 14px; }
  .rule { font-size: clamp(17px, 1.6vw, 21px); color: var(--text-2); line-height: 1.5; }
  .opening-media {
    position: relative; overflow: hidden; border-radius: 12px;
    border: 1px solid var(--border); background: #0a0c11; aspect-ratio: 1400 / 880;
  }
  .opening-media img, .opening-media video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .opening-media:has(video) .poster { display: none; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin-top: 16px; font-size: 12px; color: var(--text-2); letter-spacing: 0.02em; }
  .facts li::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 8px; vertical-align: middle; }
  @media (prefers-reduced-motion: reduce) {
    .opening-media video { display: none; }
    .opening-media:has(video) .poster { display: block; }
  }
</style>
