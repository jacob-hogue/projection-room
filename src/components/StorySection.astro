---
/** The written story: short sections that read on their own, in the film's order. */
export interface StoryPart {
  id: string;
  heading: string;
  body: string;
}
interface Props {
  parts: StoryPart[];
}
const { parts } = Astro.props;
---
<section class="essay" aria-label="The story">
  {parts.map((p) => (
    <div class="part" id={p.id}>
      <h2>{p.heading}</h2>
      <p>{p.body}</p>
    </div>
  ))}
</section>

<style>
  .essay { max-width: 1200px; margin: 0 auto; padding: 8px 24px 16px; display: grid; gap: 28px; }
  .part { max-width: 66ch; }
  .part h2 { font-size: clamp(22px, 2.4vw, 30px); margin-bottom: 10px; }
  .part p { font-size: 18px; line-height: 1.7; color: var(--text-2); }
</style>
