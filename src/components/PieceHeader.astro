---
/** The top of a piece page: category tag, title, rule, and the facts row with what the piece demonstrates. */
import PieceTag from './PieceTag.astro';
import { pieceBySlug } from '../content/pieces';
interface Props {
  slug: string;
  facts: string[];
}
const { slug, facts } = Astro.props;
const piece = pieceBySlug(slug);
if (!piece) throw new Error(`no piece ${slug} in the manifest`);
---
<section class="opening">
  <div class="opening-meta">
    <PieceTag category={piece.category} />
    <span class="mono opening-runtime">{piece.runtime}</span>
  </div>
  <h1>{piece.title}</h1>
  <p class="rule">{piece.rule}</p>
  <p class="demo"><span class="mono">Demonstrates</span> {piece.demonstrates.join(', ')}</p>
  <ul class="facts mono">
    {facts.map((f) => <li>{f}</li>)}
  </ul>
</section>

<style>
  .opening { max-width: 1200px; margin: 0 auto; padding: 56px 24px 20px; }
  .opening-meta { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; }
  .opening-runtime { font-size: 11px; color: var(--text-2); letter-spacing: 0.04em; }
  .opening h1 { font-size: clamp(34px, 5vw, 60px); margin-bottom: 14px; }
  .rule { font-size: clamp(17px, 1.6vw, 21px); color: var(--text-2); line-height: 1.5; max-width: 60ch; }
  .demo { margin-top: 12px; font-size: 15px; color: var(--text-2); max-width: 70ch; }
  .demo .mono { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-1); margin-right: 6px; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin-top: 16px; font-size: 12px; color: var(--text-2); letter-spacing: 0.02em; }
  .facts li::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 8px; vertical-align: middle; }
</style>
