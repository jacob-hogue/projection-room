---
/**
 * A chrome-free page that mounts the 1947 map at poster size with a caption band.
 * render_poster.mjs opens it, reads window.__stage.toSVG() and screenshots #poster.
 */
const W = 1600;
const MAP_H = 880;
const H = 1000;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The dial-pulse map, 1947 poster</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="poster" style={`width:${W}px;height:${H}px`}>
      <svg id="stage" viewBox={`0 0 ${W} ${MAP_H}`} width={W} height={MAP_H} role="img" aria-label="Area codes of the lower 48 states in 1947, colored by the clicks it took to dial them"></svg>
      <div class="band">
        <div class="band-title">
          <h1>The dial-pulse map</h1>
          <p>In 1947 the biggest cities got the area codes that were fastest to dial. Every territory is colored by how many clicks its code took.</p>
        </div>
        <ul class="band-facts">
          <li>77 United States area codes, October 1947</li>
          <li>Polygons: UCLA Geoportal, 2015, traced back by code lineage</li>
          <li>jacob-hogue.github.io/projection-room</li>
        </ul>
      </div>
    </div>
    <script>
      import { mountPoster } from '../../scripts/poster-page';
      mountPoster(1600, 880);
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: #0f1117; color: #e8eaed; font-family: 'DM Sans', system-ui, sans-serif; }
  #poster { position: relative; background: #0f1117; overflow: hidden; }
  #stage { display: block; }
  .band { height: 120px; display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 0 40px; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .band h1 { margin: 0 0 6px; font-size: 30px; letter-spacing: -0.02em; line-height: 1.1; }
  .band p { margin: 0; font-size: 15px; color: #8b8fa3; max-width: 70ch; line-height: 1.45; }
  .band-facts { list-style: none; margin: 0; padding: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; color: #8b8fa3; text-align: right; line-height: 1.8; white-space: nowrap; }
  .band-facts li:last-child { color: #4ade80; }
</style>
