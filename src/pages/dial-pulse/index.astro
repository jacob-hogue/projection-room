---
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import FilmSection from '../../components/FilmSection.astro';
import PieceHeader from '../../components/PieceHeader.astro';
import { pieceBySlug } from '../../content/pieces';
import Post from '../../components/Post.astro';
import TechStack from '../../components/TechStack.astro';
import post from '../../content/dial-pulse/post.json';
import sources from '../../content/dial-pulse/sources.json';
import stack from '../../content/dial-pulse/stack.json';

const base = import.meta.env.BASE_URL;
const piece = pieceBySlug('dial-pulse')!;
const title = piece.title;
const rule = piece.rule;
const filmPath = join(process.cwd(), 'public', 'dial-pulse', 'film.mp4');
const filmExists = existsSync(filmPath);
// The version changes with every render, so browsers never resume an old copy under the same URL.
const filmSrc = filmExists ? `${base}dial-pulse/film.mp4?v=${Math.floor(statSync(filmPath).mtimeMs / 1000)}` : null;
---
<Base title={title} description={rule}>
  <PieceHeader slug="dial-pulse" facts={['Area code boundaries: October 2015', 'Population: 1950 Census', 'November 2026']} />
  <FilmSection
    src={filmSrc}
    poster={`${base}dial-pulse/poster.png`}
    title={`${title}, the film`}
    posterAlt="The 1947 area code map of the lower 48 states, each territory colored by the clicks it took to dial, gold for the fastest and plum for the slowest."
    downloadName="the-dial-pulse-map.mp4"
  />
  <TechStack items={stack} />
  <Post sections={post} sources={sources} />
</Base>

