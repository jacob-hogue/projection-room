---
import Base from '../layouts/Base.astro';
---
<Base title="The Lab">
  <section class="intro">
    <h1>The Lab</h1>
    <p>Geospatial data stories: a hidden rule, a map that shows it, and a short film.</p>
  </section>
</Base>

<style>
  .intro { max-width: 1080px; margin: 0 auto; padding: 72px 24px 48px; }
  .intro h1 { font-size: clamp(36px, 5vw, 56px); margin-bottom: 16px; }
  .intro p { font-size: 18px; max-width: 54ch; }
</style>
