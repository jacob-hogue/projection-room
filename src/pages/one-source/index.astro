---
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import FilmSection from '../../components/FilmSection.astro';
import Post from '../../components/Post.astro';
import TechStack from '../../components/TechStack.astro';
import post from '../../content/one-source/post.json';
import sources from '../../content/one-source/sources.json';
import stack from '../../content/one-source/stack.json';

const base = import.meta.env.BASE_URL;
const title = 'One Source';
const rule = 'A county keeps five copies of its parcel map. One database and a nightly update bring them together.';
const filmPath = join(process.cwd(), 'public', 'one-source', 'film.mp4');
const filmExists = existsSync(filmPath);
// The version changes with every render, so browsers never resume an old copy under the same URL.
const filmSrc = filmExists ? `${base}one-source/film.mp4?v=${Math.floor(statSync(filmPath).mtimeMs / 1000)}` : null;
---
<Base title={title} description={rule}>
  <section class="opening">
    <h1>{title}</h1>
    <p class="rule">{rule}</p>
    <ul class="facts mono">
      <li>Parcels: MassGIS, read November 10, 2026</li>
      <li>351 towns, 2,558,082 parcels</li>
      <li>November 2026</li>
    </ul>
  </section>
  <FilmSection
    src={filmSrc}
    poster={`${base}one-source/poster.png`}
    title={`${title}, the film`}
    posterAlt="Massachusetts with every town tinted by the share of its parcels edited since 2023, the freshest towns in bright green, beside a rail of statewide counts."
    downloadName="one-source.mp4"
  />
  <TechStack items={stack} />
  <Post sections={post} sources={sources} />
</Base>

<style>
  .opening { max-width: 1200px; margin: 0 auto; padding: 56px 24px 20px; }
  .opening h1 { font-size: clamp(34px, 5vw, 60px); margin-bottom: 14px; }
  .rule { font-size: clamp(17px, 1.6vw, 21px); color: var(--text-2); line-height: 1.5; max-width: 60ch; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin-top: 16px; font-size: 12px; color: var(--text-2); letter-spacing: 0.02em; }
  .facts li::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 8px; vertical-align: middle; }
</style>
