---
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import FilmSection from '../../components/FilmSection.astro';
import PieceHeader from '../../components/PieceHeader.astro';
import { pieceBySlug } from '../../content/pieces';
import Post from '../../components/Post.astro';
import TechStack from '../../components/TechStack.astro';
import post from '../../content/parcel-problem/post.json';
import sources from '../../content/parcel-problem/sources.json';
import stack from '../../content/parcel-problem/stack.json';

const base = import.meta.env.BASE_URL;
const piece = pieceBySlug('parcel-problem')!;
const title = piece.title;
const rule = piece.rule;
const filmPath = join(process.cwd(), 'public', 'parcel-problem', 'film.mp4');
const filmExists = existsSync(filmPath);
// The version changes with every render, so browsers never resume an old copy under the same URL.
const filmSrc = filmExists ? `${base}parcel-problem/film.mp4?v=${Math.floor(statSync(filmPath).mtimeMs / 1000)}` : null;
---
<Base title={title} description={rule}>
  <PieceHeader slug="parcel-problem" facts={['Parcels: MassGIS, read November 10, 2026', '351 towns, 2,558,082 parcels', 'November 2026']} />
  <FilmSection
    src={filmSrc}
    poster={`${base}parcel-problem/poster.png`}
    title={`${title}, the film`}
    posterAlt="Massachusetts with every town tinted by the share of its parcels edited since 2023, the freshest towns in bright green, beside a rail of statewide counts."
    downloadName="the-parcel-problem.mp4"
  />
  <TechStack items={stack} />
  <Post sections={post} sources={sources} />
</Base>

