---
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import FilmSection from '../../components/FilmSection.astro';
import PieceHeader from '../../components/PieceHeader.astro';
import { pieceBySlug } from '../../content/pieces';
import Post from '../../components/Post.astro';
import TechStack from '../../components/TechStack.astro';
import post from '../../content/spatial-join/post.json';
import sources from '../../content/spatial-join/sources.json';
import stack from '../../content/spatial-join/stack.json';

const base = import.meta.env.BASE_URL;
const piece = pieceBySlug('spatial-join')!;
const title = piece.title;
const rule = piece.rule;
const filmPath = join(process.cwd(), 'public', 'spatial-join', 'film.mp4');
const filmExists = existsSync(filmPath);
// The version changes with every render, so browsers never resume an old copy under the same URL.
const filmSrc = filmExists ? `${base}spatial-join/film.mp4?v=${Math.floor(statSync(filmPath).mtimeMs / 1000)}` : null;
---
<Base title={title} description={rule}>
  <PieceHeader slug="spatial-join" facts={['Pickups: Uber, September 2014', 'Zones: NYC TLC taxi zones', 'November 2026']} />
  <FilmSection
    src={filmSrc}
    poster={`${base}spatial-join/poster.png`}
    title={`${title}, the film`}
    posterAlt="The same few blocks of Manhattan under four grid systems, Geohash, S2, H3 and A5. Cells inside one taxi zone are teal and cells that cross a zone boundary are amber."
    downloadName="the-spatial-join.mp4"
  />
  <TechStack items={stack} />
  <Post sections={post} sources={sources} />
</Base>

